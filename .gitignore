# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# frontend
frontend/node_modules/
frontend/.next/

# backend
backend/venv/

# production
/build

# misc
.DS_Store
*.pem
*.pyc
__pycache__/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design-sync (claude.ai/design): tooling + generated build output.
# Durable inputs under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, ds-fonts.css) and the frontend build inputs (_ds-entry.ts,
# .ds-tw-input.css) ARE committed; everything below is regenerated per sync.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
frontend/.design-sync-tw.css
