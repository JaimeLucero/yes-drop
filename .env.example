# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Analytics (frontend) — GA4 Measurement ID. Analytics is disabled if unset.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Email (Brevo)
BREVO_USER=your-brevo-email
BREVO_PASS=your-brevo-smtp-key

# Cron
CRON_SECRET=your-random-secret

# AI compose (Gemini) — backend only, never exposed to the browser.
GEMINI_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash        # optional override
# Rate limits for the shared free-tier key (optional overrides):
# AI_RPM_USER=3    AI_RPD_USER=15    AI_RPM_GLOBAL=8    AI_RPD_GLOBAL=200