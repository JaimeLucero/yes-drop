# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Analytics (frontend): GA4 Measurement ID. Analytics is disabled if unset.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Base URL for auth redirects (OAuth callback, email confirm, password reset).
# Unset in production, where the running origin is already correct. Set it in
# frontend/.env.local for local dev (http://localhost:3000) or to a tunnel URL
# when testing OAuth publicly. The origin must also be allowlisted in Supabase
# under Authentication -> URL Configuration -> Redirect URLs, or Supabase
# discards it and falls back to the project's Site URL.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Brevo)
BREVO_USER=your-brevo-email
BREVO_PASS=your-brevo-smtp-key

# Cron
CRON_SECRET=your-random-secret

# AI compose uses each user's own provider key (stored encrypted with TOKEN_ENC_KEY).
# Per-user rate limits (optional overrides):
# AI_RPM_USER=3    AI_RPD_USER=15